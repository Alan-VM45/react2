<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MiEcommerce</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>



  <!-- Contenido de la tienda -->
  <div id="main-content">

<!-- Barra superior -->
<header class="top-bar">
  <div class="logo">MiE<span class="highlight">commerce</span></div>

  <div class="search-container">
  <form method="GET" action="/search" style="display: flex; width: 100%;">
    <input type="text" name="query" placeholder="Buscar productos..." class="search-bar" required>
    <button type="submit" class="search-button" style="padding: 8px 16px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">🔍</button>
  </form>
</div>

  <div class="user-profile">
    <a href="/profile" class="cart-button">👤 <span class="highlight">Usuario</span></a>
    <!-- Botón de carrito -->
    <a href="/cart" class="cart-button">🛒 <span class="highlight">Carrito</span> <span class="cart-count"><%= cartCount %></span></a>
  </div>
</header>


    <!-- Categorías -->
    <nav class="categories">
      <a href="/categories/electronica" class="category">📱<br>Electrónica</a>
      <a href="/categories/alimentos" class="category">🍔<br>Alimentos</a>
      <a href="/categories/bebidas" class="category">🥤<br>Bebidas</a>
      <a href="/categories/indumentaria" class="category">👕<br>Indumentaria</a>
      <a href="/categories/juegos" class="category">🎮<br>Juegos</a>
      <a href="/categories/automotor" class="category">🚗<br>Automotor</a>
      <a href="/categories/hogar" class="category">🏠<br>Hogar</a>
      <a href="/categories/otros" class="category">🎁<br>Otros</a>
    </nav>

    <!-- Promociones -->
    <section class="promotions">
      <div class="promo">🎬 50% OFF en Combo Plus - Canjeando 50.000 puntos</div>
      <div class="promo">📺 50% OFF en HBO Max - Canjeando 50.000 puntos</div>
    </section>

    <section class="product-section">
      <h2>Te puede interesar</h2>
      <div class="product-grid">
        <% suggestedProducts.forEach(product => { %>
          <div class="product">
            <% if (product.stock === 0) { %>
              <span class="stock-badge out-of-stock">Sin stock</span>
            <% } %>
            <a href="/products/<%= product.id %>">
              <img src="<%= product.image || '/images/imagenes/fallback.png' %>" alt="<%= product.title %>">
              <div><%= product.title %></div>
              <span><%= product.price %> puntos</span>
            </a>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Los más pedidos -->
    <section class="product-section">
      <h2>Los más pedidos</h2>
      <div class="product-grid">
        <% popularProducts.forEach(product => { %>
          <div class="product">
            <% if (product.stock === 0) { %>
              <span class="stock-badge out-of-stock">Sin stock</span>
            <% } %>
            <a href="/products/<%= product.id %>">
              <img src="<%= product.image || '/images/imagenes/fallback.png' %>" alt="<%= product.title %>">
              <div><%= product.title %></div>
              <span><%= product.price %> puntos</span>
            </a>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-categories">
        <div>📱 Electrónica</div>
        <div>🍔 Alimentos</div>
        <div>🥤 Bebidas</div>
        <div>👕 Indumentaria</div>
        <div>🎮 Juegos</div>
        <div>🚗 Automotor</div>
        <div>🏠 Hogar</div>
        <div>🎁 Otros</div>
      </div>
      <div class="footer-bottom">
        <p>© MiEcommerce. Todos los derechos reservados.</p>
      </div>
    </footer>

  </div>
</body>
</html>
