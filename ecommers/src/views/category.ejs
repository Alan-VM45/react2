<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Categoría: <%= category %> - MiEcommerce</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div id="main-content">
        <!-- Barra superior -->
        <header class="top-bar">
            <div class="logo"><a href="/home" style="text-decoration: none; color: inherit;">MiE<span class="highlight">commerce</span></a></div>
            <div class="user-profile">
                <a href="/profile" class="cart-button">👤 <span class="highlight">Usuario</span></a>
                <a href="/cart" class="cart-button">🛒 <span class="highlight">Carrito</span> <span class="cart-count"><%= cartCount %></span></a>
            </div>
        </header>

        <section class="product-section">
            <h1 style="margin-bottom: 20px; text-transform: capitalize;">Categoría: <%= category %></h1>
            
            <div class="product-grid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <div class="product">
                            <% if (product.stock === 0) { %>
                                <span class="stock-badge out-of-stock">Sin stock</span>
                            <% } %>
                            <a href="/products/<%= product.id %>" style="text-decoration: none; color: inherit;">
                                <img src="<%= product.image || '/images/imagenes/fallback.png' %>" alt="<%= product.title %>">
                                <div><%= product.title %></div>
                                <span><%= product.price %> puntos</span>
                            </a>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No se encontraron productos en esta categoría.</p>
                <% } %>
            </div>
            
            <div style="margin-top: 40px;">
                <a href="/home" class="cart-button">Volver al inicio</a>
            </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-bottom">
                <p>© MiEcommerce. Todos los derechos reservados.</p>
            </div>
        </footer>
    </div>
</body>
</html>
